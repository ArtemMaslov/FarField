/*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
/*---------------------------------------------------------------------------*/

ddtSchemes
{
    default Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    dbns
    {
        flux           hllc;
        limiter        Venkatakrishnan;
    }
}

laplacianSchemes
{}

interpolationSchemes
{
    default               none;
    interpolate(rho)      linear;
}

snGradSchemes
{}

