/*---------------------------------------------------------------------------*/
FoamFile
{
    version     1.0;
    format      ascii;
    class       dictionary;
    object      farfieldProperties;
}
/*---------------------------------------------------------------------------*/

referenceLength      #eval {6.9 * 2.54/100}; // 0.17526 m
referencePressure    9183;

r0 #eval {24.8 * 2.54/100}; // 0.62992 m
r1 #eval {31.8 * 2.54/100}; // 0.80772 m

inputNearField
{
    path "./input/t0.010_rl3.6_phi0.csv";
    type input;
    xUnits abs;
    pUnits abs;
}

outputFiles
{
    nf
    {
        path "output/nearField.csv";
        type nearField;

        xUnits abs;
        pUnits rel;
        xColumnName "x";
        yColumnName "dp_p";
    }

    WhF
    {
        path "output/F-function.csv";
        type WhithamFunction;

        xColumnName "y";
        yColumnName "F";
    }

    ff
    {
        path "output/farfield.csv";
        type farField;

        xUnits abs;
        pUnits rel;
        xColumnName "x";
        yColumnName "dp_p";

        logShocksFilePath "farfieldShocks.csv";
    }
}

WhithamParams
{
    p0 9183;
    p1 101325;
    HeatCapacity         1.4;
    MachNumber           1.7;
    integrateStepsCount  100;
    iterationsCount      30;
}

/*---------------------------------------------------------------------------*/
